#######################################################################
# Society Maintenance Tracker — environment contract
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
#
# Every variable below is read exactly once, in `src/lib/env.ts`, where it
# is validated with Zod at process start. A missing or malformed required
# variable fails the boot loudly instead of surfacing as a runtime 500.
#######################################################################

# ---------------------------------------------------------------------
# CORE (required)
# ---------------------------------------------------------------------

# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/society_maintenance
# Neon:   copy the *pooled* connection string from the Neon dashboard and
#         keep `?sslmode=require`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/society_maintenance"

# Direct (non-pooled) connection, used only by migrations (`npm run db:migrate`).
# On Neon this is the "Direct connection" string. Locally it equals DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/society_maintenance"

# Public origin of the app. Used to build links inside emails and to set
# secure cookie behaviour. No trailing slash.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
APP_URL="http://localhost:3000"

# Secret used to derive session-token hashes. Generate with:
#   openssl rand -base64 48
# Rotating this value invalidates every existing session (by design).
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"


# ---------------------------------------------------------------------
# BUSINESS RULES
# ---------------------------------------------------------------------

# Seeds the initial overdue threshold. After first run the authoritative
# value lives in the `app_settings` table and is editable by an admin in
# Settings — this variable only bootstraps it.
OVERDUE_THRESHOLD_DAYS="7"


# Test-only: disables the in-memory rate limiter so the integration suite can
# sign in repeatedly from one address. Force-ignored when NODE_ENV=production,
# so it cannot weaken a real deployment.
RATE_LIMIT_DISABLED="false"


# ---------------------------------------------------------------------
# PHOTO STORAGE — Cloudinary (optional in development)
#
# Leave all three blank to use the built-in local-disk storage provider,
# which writes to /public/uploads. The app is fully functional without
# these; only the production upload path needs them.
#
# Dashboard → https://console.cloudinary.com  →  Settings → API Keys
# CLOUDINARY_API_SECRET is server-only and must NEVER be exposed to the client.
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Folder that all complaint photos are written into.
CLOUDINARY_UPLOAD_FOLDER="society-maintenance/complaints"


# ---------------------------------------------------------------------
# EMAIL — Resend (optional in development)
#
# Leave RESEND_API_KEY blank to use the console provider: emails are
# rendered and logged instead of sent, and every attempt is still recorded
# in the `email_outbox` table and visible in Admin → Email log.
#
# Dashboard → https://resend.com/api-keys → Create API Key (Sending access)
# ---------------------------------------------------------------------
RESEND_API_KEY=""

# Verified sender. Without a custom domain Resend only permits
# "onboarding@resend.dev", which can only deliver to your own account email.
EMAIL_FROM="Society Maintenance <onboarding@resend.dev>"

# Safety valve for demos: when set, EVERY outgoing email is redirected to
# this address regardless of the real recipient, and the intended recipient
# is shown in the subject line. Leave blank in real production.
EMAIL_REDIRECT_TO=""


# ---------------------------------------------------------------------
# SEED DATA (development / demo only)
#
# Used by `npm run db:seed`. Change these before seeding a public
# deployment, and never reuse a real password.
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@greenwoodheights.in"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_RESIDENT_PASSWORD="Resident@12345"
