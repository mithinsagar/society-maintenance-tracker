/public/uploads/*
!/public/uploads/.gitkeep

# database
/prisma/*.db
/prisma/*.db-journal
/pgdata

# vercel
.vercel

# editor / os
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# typescript incremental build info
*.tsbuildinfo
